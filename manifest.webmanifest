{
  "id": "./",
  "name": "CALLE360ONCE · Andalucía",
  "short_name": "CALLE360ONCE",
  "description": "Cartografía, agenda, visitas y accesibilidad para el trabajo de calle en Andalucía.",
  "lang": "es-ES",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#edf3f8",
  "theme_color": "#087f83",
  "icons": [
    {
      "src": "./calle360once-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./calle360once-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./calle360once.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "contacts",
          "accept": [
            "text/vcard",
            "text/x-vcard",
            "application/vcard",
            "application/x-vcard",
            ".vcf"
          ]
        }
      ]
    }
  }
}
